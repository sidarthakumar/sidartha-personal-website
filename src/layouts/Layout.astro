---
import profile from '../data/profile.json';
import '../styles/site.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  article?: boolean;
  published?: Date;
  updated?: Date;
  contactBand?: boolean;
}
const {
  title,
  description,
  noindex = false,
  article = false,
  published,
  updated,
  contactBand = true,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
  Astro.site,
).href;
const nav = [
  ['/', 'Home'],
  ['/about/', 'About'],
  ['/skills/', 'Skills'],
  ['/projects/', 'Projects'],
  ['/journey/', 'Journey'],
  ['/insights/', 'Insights'],
  ['/contact/', 'Contact'],
];
const person = {
  '@type': 'Person',
  '@id': 'https://sidarthakumar.com/#person',
  name: profile.name,
  url: 'https://sidarthakumar.com',
  sameAs: [profile.github],
  knowsAbout: [
    'Web development',
    'Search engine optimization',
    'Software testing',
  ],
};
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      datePublished: published?.toISOString(),
      dateModified: (updated || published)?.toISOString(),
      author: {
        '@type': 'Person',
        name: profile.name,
        url: 'https://sidarthakumar.com/about/',
      },
      mainEntityOfPage: canonical,
    }
  : {
      '@context': 'https://schema.org',
      '@type': ['/', '/about/'].includes(Astro.url.pathname)
        ? 'ProfilePage'
        : ['/projects/', '/insights/', '/journey/'].includes(Astro.url.pathname)
          ? 'CollectionPage'
          : 'WebPage',
      url: canonical,
      name: title,
      description,
      ...(['/', '/about/'].includes(Astro.url.pathname)
        ? { mainEntity: person }
        : { about: person }),
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1019" />
    <title>{title}{title.includes('Sidartha Kumar') ? '' : ' | Sidartha Kumar'}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sidartha Kumar — Insights"
      href="/feed.xml"
    />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Sidartha Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {article && published && (
      <meta
        property="article:published_time"
        content={published.toISOString()}
      />
    )}
    {article && updated && (
      <meta property="article:modified_time" content={updated.toISOString()} />
    )}
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    )}
    <script is:inline defer src="/scripts/navigation.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Sidartha Kumar — Home">
          <span class="brand-mark" aria-hidden="true">
            s.k
          </span>
          <span>
            <strong>Sidartha Kumar</strong>
            <span class="brand-caption">BUILDING WITH CARE</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          aria-controls="primary-navigation"
          aria-expanded="false"
          hidden
        >
          Menu <span aria-hidden="true">☰</span>
        </button>
        <nav id="primary-navigation" aria-label="Primary navigation">
          {nav.map(([href, label]) => (
            <a
              href={href}
              aria-current={Astro.url.pathname === href ? 'page' : undefined}
              class:list={{ 'nav-contact': href === '/contact/' }}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {contactBand && (
      <section class="container contact-band" aria-labelledby="contact-heading">
        <div>
          <p class="eyebrow">LET’S CONNECT</p>
          <h2 id="contact-heading">
            Good work starts
            <br />
            with a conversation.
          </h2>
          <p>Have a role, a project, or a practical problem in mind?</p>
        </div>
        <a class="button button-primary" href="/contact/">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </section>
    )}
    <footer class="site-footer container">
      <div class="footer-top">
        <a class="footer-name" href="/">
          Sidartha Kumar
          <span>Learning with curiosity. Building with care.</span>
        </a>
        <div>
          <a href={profile.github} rel="me">
            GitHub ↗
          </a>
          <a href="/contact/">Get in touch ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Sidartha Kumar</span>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="#top" data-back-to-top>
          Back to top ↑
        </a>
      </div>
    </footer>
  </body>
</html>
