---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Timeline from '../components/Timeline.astro';
import releases from '../data/releases.json';
import { displayDate } from '../lib/content';
---

<Layout
  title="Learning Journey & Project Milestones | Sidartha Kumar"
  description="Follow Sidartha Kumar’s development journey, current learning, portfolio milestones, and release updates linked to the source on GitHub."
>
  <PageHeading
    eyebrow="LEARNING JOURNEY"
    title="The work behind the progress."
    description="The background, learning, and project milestones that shape where I’m going next."
  />
  <section class="container journey-layout section-compact">
    <div class="journey-aside">
      <p class="eyebrow">THE LONG VIEW</p>
      <h2>
        Stay curious.
        <br />
        Keep building.
      </h2>
      <p>
        Experience gives me a starting point. Each project gives me another
        question to explore.
      </p>
    </div>
    <div>
      <h2 class="subheading">Learning & milestones</h2>
      <Timeline />
      {releases.length > 0 && (
        <section class="release-section">
          <h2 class="subheading">From the project releases</h2>
          <ol class="timeline">
            {releases.map((release) => (
              <li>
                <p class="metadata">
                  <time datetime={release.date}>
                    {displayDate(new Date(release.date))}
                  </time>{' '}
                  · {release.tag}
                </p>
                <h3>
                  <a href={release.url}>{release.title} ↗</a>
                </h3>
                <p class="release-summary">{release.summary}</p>
                <a class="text-link" href={release.url}>
                  Read the release on GitHub ↗
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </section>
</Layout>
