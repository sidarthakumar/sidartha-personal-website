---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Timeline from '../components/Timeline.astro';
import profile from '../data/profile.json';
import { projects, articles } from '../lib/content';
const work = await projects();
const notes = await articles();
---

<Layout
  title="Sidartha Kumar | Web Development, APIs & AI"
  description="Explore Sidartha Kumar’s development background, portfolio projects, and practical notes on full-stack applications, APIs, SEO, and AI automation."
>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="live-dot" aria-hidden="true"></span>DEVELOPMENT · APIs · AI
        EXPLORATION
      </p>
      <h1>
        Building practical technology.
        <span>
          With care, from
          <br />
          idea to delivery.
        </span>
      </h1>
      <p class="hero-intro">{profile.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">
          Explore my work <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-secondary" href="/contact/">
          Let’s talk
        </a>
      </div>
      <a class="quiet-link" href={profile.github}>
        Follow the work on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="identity-card">
      <div class="identity-top">
        <span>THE PERSONAL LOGBOOK</span>
        <span>01 / IN PROGRESS</span>
      </div>
      <div class="identity-art" aria-hidden="true">
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
        <span class="orbit-dot"></span>
        <span class="monogram">
          sk<span>.</span>
        </span>
        <span class="art-plus">+</span>
        <span class="art-star">✧</span>
      </div>
      <div class="identity-bottom">
        <strong>Sidartha Kumar</strong>
        <span>Experience, curiosity & the next useful thing.</span>
      </div>
      <div class="identity-status">
        <span class="live-dot" aria-hidden="true"></span>Learning openly.
        Building thoughtfully.
      </div>
    </div>
  </section>
  <section class="experience-strip container" aria-label="Experience overview">
    {profile.experience.map((item) => (
      <div>
        <strong>{item.duration}</strong>
        <span>{item.area}</span>
      </div>
    ))}
    <a href="/about/">
      The background
      <br />
      behind the work <span aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / THE WORK</p>
        <h2>
          Ideas, becoming
          <br />
          something useful.
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        All projects ↗
      </a>
    </div>
    <div class="featured-grid">
      {work.slice(0, 1).map((project) => (
        <ProjectCard project={project} />
      ))}
      <aside class="work-note">
        <p class="eyebrow">THE WAY I WORK</p>
        <span class="note-star" aria-hidden="true">
          ✳
        </span>
        <h3>
          Understand the problem.
          <br />
          Build with intention.
        </h3>
        <p>
          My background in development, SEO, and testing shapes how I approach a
          website: how it works, how people use it, and how they find it.
        </p>
        <p>
          I’m bringing that experience into a deeper focus on full-stack
          applications and practical AI automation.
        </p>
        <a class="text-link" href="/about/">
          More about my approach ↗
        </a>
      </aside>
    </div>
  </section>
  <section class="section section-bordered">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / CURRENT FOCUS</p>
          <h2>
            Experience to build on.
            <br />
            More to explore.
          </h2>
        </div>
        <a class="text-link" href="/skills/">
          Skills & learning ↗
        </a>
      </div>
      <p class="section-intro">
        Deepening the connections between interfaces, applications, and the data
        behind them.
      </p>
      <div class="focus-grid">
        {profile.learning.slice(0, 4).map((item, i) => (
          <article class="focus-card">
            <span class="focus-index">0{i + 1} / LEARNING</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="tags">
              {item.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section container journey-preview">
    <div>
      <p class="eyebrow">03 / THE JOURNEY</p>
      <h2>
        Progress has
        <br />a process.
      </h2>
      <p class="section-intro">
        The background, current questions, and milestones that move the work
        forward.
      </p>
      <a class="text-link" href="/journey/">
        The full timeline ↗
      </a>
    </div>
    <Timeline limit={2} />
  </section>
  <section class="section section-bordered">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">04 / THE NOTEBOOK</p>
          <h2>Notes from the work.</h2>
        </div>
        <a class="text-link" href="/insights/">
          All insights ↗
        </a>
      </div>
      <div class="articles-grid">
        {notes.slice(0, 3).map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </div>
  </section>
</Layout>
