---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="container page-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {description && <p class="page-intro">{description}</p>}
</section>
