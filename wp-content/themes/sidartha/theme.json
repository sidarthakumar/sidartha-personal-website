{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": { "contentSize": "740px", "wideSize": "1184px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "night", "name": "Night", "color": "#0c1019" },
        { "slug": "paper", "name": "Paper", "color": "#f0f1f6" },
        { "slug": "violet", "name": "Violet", "color": "#b7abfa" },
        { "slug": "muted", "name": "Muted", "color": "#a5adbe" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System sans",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        }
      ]
    },
    "spacing": { "units": ["px", "rem", "%", "vw"] }
  }
}
